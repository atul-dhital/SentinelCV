# ─── Database ────────────────────────────────────────────────────────────────
# Local PostgreSQL (default dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/visitor_db
# Supabase / Vercel Postgres — fill these to use Supabase as the backend DB
POSTGRES_URL_NON_POOLING=
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_HOST=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE=postgres

# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ─── Auth / Security ────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_with_secrets_token_hex_32
# Must be DIFFERENT from SECRET_KEY — rotating one must not break the other
EMBEDDING_KEY_SECRET=CHANGE_ME_generate_with_different_secrets_token_hex_32

# ─── AI Services ─────────────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8001
API_BASE_URL=http://localhost:8000/api/v1

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ─── Redis (for background tasks) ───────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(24))"
REDIS_PASSWORD=CHANGE_ME_strong_random_password
REDIS_URL=redis://:CHANGE_ME_strong_random_password@localhost:6379/0
VIDEO_JOB_QUEUE_MODE=redis
SYNTHETIC_JOB_QUEUE_MODE=redis
TEMPORAL_JOB_QUEUE_MODE=redis

# local | r2 | s3
STORAGE_TYPE=local
# Cloudflare R2
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PREFIX=
# Public dev URL from R2 bucket settings (optional)
OBJECT_STORAGE_PUBLIC_BASE_URL=

# ─── Face Recognition ───────────────────────────────────────────────────────
FACE_CONFIDENCE_THRESHOLD=0.6
# Refuse the weak pixel-similarity fallback embedding (only real ArcFace identities).
# Default 0 in dev so the app runs without the ONNX models installed; set to 1 in
# production. Check GET /health -> recognition.real_recognition to see if the real
# backend is actually loaded.
SENTINELCV_STRICT_RECOGNITION=0
# Match threshold (cosine 0..1). Tune with:
#   python backend/scripts/calibrate_threshold.py --org <ORG>
FACE_SEARCH_THRESHOLD=0.6
# Min enrollment image quality (0..1). Blurry reference images are rejected at enrollment.
FACE_QUALITY_MIN=0.15
# InsightFace speed: only load the models embedding needs. Loading the full pack
# (3D+2D landmarks, gender/age) adds ~4-5s PER face on CPU for no benefit here.
# detection,recognition keeps the 5 keypoints we use. ~5.4s -> ~1.3s per call.
INSIGHTFACE_MODULES=detection,recognition
INSIGHTFACE_DET_SIZE=640
# ── Camera-identification latency tuning ──────────────────────────────────────
# Pre-load + warm YOLO and ArcFace at service startup so the FIRST camera frame
# isn't slow (otherwise ~280MB buffalo_l loads lazily on first request). Set 0
# to disable (e.g. fast test restarts).
AI_PREWARM=1
# Execution providers. Leave blank to auto-detect: CUDA when onnxruntime-gpu is
# installed, else CPU. Override e.g. CUDAExecutionProvider,CPUExecutionProvider
INSIGHTFACE_PROVIDERS=
# YOLO device. Blank = auto (GPU "0" if a CUDA torch build sees a GPU, else cpu).
# Force with "0" (first GPU) or "cpu".
YOLO_DEVICE=
# CPU-only fallback to cut steady-state latency (lower accuracy at distance):
#   smaller detector pack + smaller detection input. Use on machines w/o GPU.
# INSIGHTFACE_MODEL_PACK=buffalo_s
# INSIGHTFACE_DET_SIZE=384
# Downscale live frames before detection (cap longest width, px). 0 = no cap.
# Big win on high-res webcams; bboxes are rescaled back to original coords.
REALTIME_MAX_WIDTH=960
PGVECTOR_INDEX_TYPE=hnsw
PGVECTOR_IVFFLAT_LISTS=100
AUTO_ENSURE_PGVECTOR_FACE_INDEX=1

# ─── Environment / Runtime ───────────────────────────────────────────────────
# Set to "production" to enforce PostgreSQL, strong secrets, and strict checks
SENTINELCV_ENV=development
# Comma-separated allowed hostnames (production must set this)
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated CORS origins
ALLOWED_ORIGINS=http://localhost:3000

# ─── Security / Auth ────────────────────────────────────────────────────────
# Minutes until access token expires (default 30)
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Days until refresh token expires (default 7)
REFRESH_TOKEN_EXPIRE_DAYS=7
# Token required by Prometheus to scrape /metrics (leave empty to disable auth)
METRICS_TOKEN=
# Shared secret for internal service-to-service requests
INTERNAL_SERVICE_KEY=

# ─── Database Pool (PostgreSQL only) ────────────────────────────────────────
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true
DB_CONNECT_TIMEOUT=30
# Set to 0 to disable automatic SQLite fallback in dev
SENTINELCV_ALLOW_SQLITE_FALLBACK=1

# ─── Multi-tenancy ───────────────────────────────────────────────────────────
# Set to 1 to enforce global SQLAlchemy tenant filter (recommended for production)
ENFORCE_TENANT_FILTER=1

# ─── Metrics / Observability ─────────────────────────────────────────────────
# Seconds to cache /metrics DB aggregates between scrapes (default 15)
METRICS_AGGREGATE_CACHE_TTL_SECONDS=15
# Seconds to cache per-org rate-limit rule lookups (default 60)
RATE_LIMIT_RULE_CACHE_TTL_SECONDS=60
# Per-IP max requests to /metrics per window (default 30)
METRICS_RATE_LIMIT_MAX=30
# Window size in seconds for /metrics rate limit (default 60)
METRICS_RATE_LIMIT_WINDOW_SECONDS=60

# ─── Request Limits ──────────────────────────────────────────────────────────
# Max allowed request body in bytes (default 50 MB)
MAX_REQUEST_BODY_BYTES=52428800

# ─── Compliance / Audit ──────────────────────────────────────────────────────
# Set to 1 to write an audit log entry on every biometric read
AUDIT_BIOMETRIC_READS=0
