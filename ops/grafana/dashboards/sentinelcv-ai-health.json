{
  "__inputs": [],
  "__requires": [
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" },
    { "type": "panel", "id": "graph", "name": "Graph", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "SentinelCV AI Model Health — face recognition latency, error rates, model registry, and learning signal queue",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "AI Service Health",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "MLflow Available",
      "type": "stat",
      "targets": [
        {
          "expr": "sentinelcv_backend_mlflow_available",
          "legendFormat": "MLflow",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 2,
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Registered Models",
      "type": "stat",
      "targets": [
        {
          "expr": "sentinelcv_backend_mlflow_registry_models",
          "legendFormat": "Models",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 200 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 3,
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Open Learning Signals",
      "type": "stat",
      "targets": [
        {
          "expr": "sentinelcv_backend_open_learning_signals",
          "legendFormat": "Open",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 4,
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Queued Learning Signals",
      "type": "stat",
      "targets": [
        {
          "expr": "sentinelcv_backend_queued_learning_signals",
          "legendFormat": "Queued",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "Request Latency",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 10,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "Average Request Latency",
      "type": "graph",
      "targets": [
        {
          "expr": "rate(sentinelcv_backend_request_latency_seconds_sum[5m]) / rate(sentinelcv_backend_request_latency_seconds_count[5m])",
          "legendFormat": "Avg latency",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 11,
      "title": "Request Rate",
      "type": "graph",
      "targets": [
        {
          "expr": "rate(sentinelcv_backend_requests_total[1m])",
          "legendFormat": "Requests/s",
          "refId": "A"
        },
        {
          "expr": "rate(sentinelcv_backend_errors_total[1m])",
          "legendFormat": "Errors/s",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "title": "Database & Redis Health",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.8 },
              { "color": "red", "value": 0.95 }
            ]
          },
          "unit": "percentunit",
          "max": 1
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 15 },
      "id": 20,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "DB Pool Utilization",
      "type": "gauge",
      "targets": [
        {
          "expr": "sentinelcv_backend_db_pool_utilization",
          "legendFormat": "Pool util",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 4, "x": 6, "y": 15 },
      "id": 21,
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Redis Connected",
      "type": "stat",
      "targets": [
        {
          "expr": "sentinelcv_backend_redis_connected",
          "legendFormat": "Redis",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "gridPos": { "h": 6, "w": 6, "x": 10, "y": 15 },
      "id": 22,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Cache Hit Ratio",
      "type": "gauge",
      "targets": [
        {
          "expr": "sentinelcv_backend_cache_hit_ratio",
          "legendFormat": "Hit ratio",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 },
      "id": 103,
      "title": "Visitor & Camera Activity",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "id": 30,
      "title": "Cumulative Visitor Log Count",
      "type": "graph",
      "targets": [
        {
          "expr": "sentinelcv_backend_visitor_logs_total",
          "legendFormat": "Total logs",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "id": 31,
      "title": "Active Cameras",
      "type": "graph",
      "targets": [
        {
          "expr": "sentinelcv_backend_cameras_total",
          "legendFormat": "Cameras",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["sentinelcv", "ai", "health"],
  "templating": { "list": [] },
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "SentinelCV — AI Model Health",
  "uid": "sentinelcv-ai-health",
  "version": 1
}
