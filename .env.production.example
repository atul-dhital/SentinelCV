# ═══════════════════════════════════════════════════════════════════════════════
# SentinelCV Production Environment Configuration
# Copy to .env.production and fill in real values before deployment
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Environment Mode ────────────────────────────────────────────────────────
SENTINELCV_ENV=production

# ─── Database (Supabase Postgres + pgvector) ─────────────────────────────────
# Use non-pooling URL for SQLAlchemy's own pool management
DATABASE_URL=postgresql://postgres.gyilluipudizbxclrylh:CHANGE_ME@aws-1-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
POSTGRES_URL_NON_POOLING=postgresql://postgres.gyilluipudizbxclrylh:CHANGE_ME@aws-1-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
POSTGRES_URL=postgresql://postgres.gyilluipudizbxclrylh:CHANGE_ME@aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&supa=base-pooler.x
POSTGRES_PRISMA_URL=postgresql://postgres.gyilluipudizbxclrylh:CHANGE_ME@aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
POSTGRES_HOST=db.gyilluipudizbxclrylh.supabase.co
POSTGRES_USER=postgres
POSTGRES_DATABASE=postgres
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true
DB_CONNECT_TIMEOUT=30

# ─── pgvector Tuning ────────────────────────────────────────────────────────
PGVECTOR_INDEX_TYPE=hnsw
PGVECTOR_HNSW_M=16
PGVECTOR_HNSW_EF_CONSTRUCTION=200
PGVECTOR_HNSW_EF_SEARCH=100

# ─── Auth / Security ────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_SECRET
EMBEDDING_KEY_SECRET=CHANGE_ME_TO_A_DIFFERENT_RANDOM_64_CHAR_SECRET
# Internal API key used by the AI service to call backend ingestion endpoints.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_SERVICE_KEY=CHANGE_ME_TO_A_RANDOM_INTERNAL_KEY
# Protects the /metrics Prometheus endpoint. Required in production.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
METRICS_TOKEN=CHANGE_ME_TO_A_RANDOM_METRICS_TOKEN
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_COST_FACTOR=12

# ─── Encrypted Env (optional) ───────────────────────────────────────────────
# SENTINELCV_ENCRYPTED_ENV_FILE=.env.production.encrypted
# SENTINELCV_ENV_KEY_FILE=/run/secrets/sentinelcv_env_key

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis-host:6379/0

# ─── Object Storage (Cloudflare R2) ─────────────────────────────────────────
STORAGE_TYPE=r2
OBJECT_STORAGE_BUCKET=sentinalcv01
OBJECT_STORAGE_ENDPOINT_URL=https://e87c56cbbc4fff5566cfebe25fb17b5d.r2.cloudflarestorage.com
OBJECT_STORAGE_REGION=auto
# Create at: Cloudflare Dashboard → R2 → Manage R2 API Tokens
OBJECT_STORAGE_ACCESS_KEY_ID=CHANGE_ME
OBJECT_STORAGE_SECRET_ACCESS_KEY=CHANGE_ME
OBJECT_STORAGE_PREFIX=
# Public dev URL (enable in R2 bucket settings first)
OBJECT_STORAGE_PUBLIC_BASE_URL=https://pub-89cc23a3088e4e5f895fefd4354d0cd6.r2.dev

# ─── Supabase Keys ───────────────────────────────────────────────────────────
SUPABASE_URL=https://gyilluipudizbxclrylh.supabase.co
SUPABASE_ANON_KEY=CHANGE_ME
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME
SUPABASE_JWT_SECRET=CHANGE_ME
NEXT_PUBLIC_SUPABASE_URL=https://gyilluipudizbxclrylh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=CHANGE_ME
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=CHANGE_ME

# ─── AI Services ─────────────────────────────────────────────────────────────
AI_SERVICE_URL=http://ai-service:8001
API_BASE_URL=https://your-domain.com/api/v1

# DANGER: when true, biometric services fall back to deterministic SHA-256
# "embeddings" if the real ML backend is unavailable. This silently corrupts
# the gallery and must remain false in production. Only enable for local
# fixtures / CI without GPU or model weights.
ALLOW_SYNTHETIC_BIOMETRIC_FALLBACK=false

# ─── Frontend ────────────────────────────────────────────────────────────────
FRONTEND_URL=https://your-domain.com
NEXT_PUBLIC_API_URL=https://your-domain.com/api/v1

# ─── Face Recognition ───────────────────────────────────────────────────────
FACE_CONFIDENCE_THRESHOLD=0.6
FACE_RECOGNITION_MODEL=arcface
# Refuse the weak pixel-similarity fallback embedding. With this ON, the system
# only produces real ArcFace (InsightFace/AdaFace) identities and returns no
# embedding when the real backend is unavailable — instead of silently storing
# a non-discriminative vector. REQUIRED for trustworthy production recognition.
# Verify the real backend is loaded via GET /health -> recognition.real_recognition == true.
SENTINELCV_STRICT_RECOGNITION=1
# Match threshold (cosine similarity 0..1). 0.6 is a starting guess — TUNE it
# against your real gallery: python backend/scripts/calibrate_threshold.py --org <ORG>
# For security, prefer slightly higher to reduce false accepts.
FACE_SEARCH_THRESHOLD=0.6
# Minimum enrollment image quality (0..1, blur/sharpness). Faces below this are
# rejected at /embed-face so blurry reference images never enter the gallery.
FACE_QUALITY_MIN=0.15
# InsightFace: load only detection+recognition (skips 3D/2D landmarks + gender/age
# that run on every call for no benefit). Cuts a face embed ~5.4s -> ~1.3s on CPU.
INSIGHTFACE_MODULES=detection,recognition
INSIGHTFACE_DET_SIZE=640

# ─── CORS / Hosts ────────────────────────────────────────────────────────────
# ALLOWED_ORIGINS: comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=https://your-domain.com
# ALLOWED_HOSTS: comma-separated list of valid Host header values.
ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# ─── Email (password reset) ─────────────────────────────────────────────────
# All four vars must be present for password-reset email delivery to work.
# The backend checks SMTP_HOST + SMTP_PORT + PASSWORD_RESET_FROM_EMAIL at startup
# and reports them in /health/readiness → password_reset_email check.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@your-domain.com
SMTP_PASSWORD=CHANGE_ME
# Must be named PASSWORD_RESET_FROM_EMAIL — the code does NOT read SMTP_FROM.
PASSWORD_RESET_FROM_EMAIL=noreply@your-domain.com
# Optional: override the reset link base URL (defaults to FRONTEND_URL/login)
PASSWORD_RESET_URL=https://your-domain.com/login
# Optional: TLS settings (defaults: SMTP_USE_TLS=true, SMTP_USE_SSL=false)
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ─── Background Jobs ────────────────────────────────────────────────────────
VIDEO_JOB_QUEUE_MODE=redis
SYNTHETIC_JOB_QUEUE_MODE=redis
TEMPORAL_JOB_QUEUE_MODE=redis
AUTO_ENSURE_PGVECTOR_FACE_INDEX=1

# ─── Storage Encryption At Rest ─────────────────────────────────────────────
# pgvector stores face embeddings as plain vector(512) floats — app-level
# encryption is impossible without breaking ANN search. Confirm storage-level
# encryption via your cloud provider, then set this to 'verified'.
# Run: python scripts/verify_storage_encryption.py
STORAGE_ENCRYPTED=verified   # set after confirming with provider

# ─── Schema Management ──────────────────────────────────────────────────────
AUTO_INIT_DB=0
# Use Alembic for migrations: alembic upgrade head

# ─── Edge / ONNX Export ─────────────────────────────────────────────────────
EDGE_EXPORT_DIR=data/edge_models

# ─── MLFlow (optional) ──────────────────────────────────────────────────────
# MLFLOW_TRACKING_URI=http://mlflow-host:5000
# MLFLOW_EXPERIMENT_NAME=sentinelcv-prod
